@@ -96,12 +96,37 @@ MossdeepCity_SpaceCenter_1F_EventScript_Scientist::
 	end
 
 MossdeepCity_SpaceCenter_1F_EventScript_ScientistPostgame::
+	goto_if_set FLAG_CAUGHT_JIRACHI, MossdeepCity_SpaceCenter_1F_EventScript_ScientistDeoxysSignal
 	msgbox MossdeepCity_SpaceCenter_1F_Text_UnusualSignalBriefing, MSGBOX_DEFAULT
 	setflag FLAG_JIRACHI_QUEST_STARTED
 	clearflag FLAG_HIDE_METEOR_FALLS_B1F_2R_STEVEN
 	release
 	end
 
+MossdeepCity_SpaceCenter_1F_EventScript_ScientistDeoxysSignal::
+	goto_if_set FLAG_AURORA_TICKET_GIVEN, MossdeepCity_SpaceCenter_1F_EventScript_ScientistDeoxysReminder
+	setvar VAR_0x8004, SPECIES_JIRACHI
+	specialvar VAR_RESULT, CheckSpeciesInParty
+	goto_if_eq VAR_RESULT, FALSE, MossdeepCity_SpaceCenter_1F_EventScript_ScientistBringJirachi
+	msgbox MossdeepCity_SpaceCenter_1F_Text_JirachiResonance, MSGBOX_DEFAULT
+	msgbox MossdeepCity_SpaceCenter_1F_Text_SecondSignal, MSGBOX_DEFAULT
+	giveitem ITEM_AURORA_TICKET
+	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_AURORA_TICKET_GIVEN
+	release
+	end
+
+MossdeepCity_SpaceCenter_1F_EventScript_ScientistBringJirachi::
+	msgbox MossdeepCity_SpaceCenter_1F_Text_BringJirachi, MSGBOX_DEFAULT
+	release
+	end
+
+MossdeepCity_SpaceCenter_1F_EventScript_ScientistDeoxysReminder::
+	msgbox MossdeepCity_SpaceCenter_1F_Text_SecondSignalReminder, MSGBOX_DEFAULT
+	release
+	end
+
 MossdeepCity_SpaceCenter_1F_EventScript_ScientistMagma::
 	msgbox MossdeepCity_SpaceCenter_1F_Text_MagmaHaveSightsOnSpaceCenter, MSGBOX_DEFAULT
 	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterRight
@@ -350,6 +375,43 @@ MossdeepCity_SpaceCenter_1F_Text_UnusualSignalBriefing:
 	.string "STEVEN, perhaps? He was headed\l"
 	.string "for the falls to study the strata.$"
 
+MossdeepCity_SpaceCenter_1F_Text_JirachiResonance:
+	.string "You… you've caught it!\n"
+	.string "The POKéMON from the falls!\p"
+	.string "Look -- the instruments! The moment\n"
+	.string "JIRACHI entered the room, the signal\l"
+	.string "spiked.\p"
+	.string "JIRACHI is a wish made of space.\n"
+	.string "Of course it would hear another\l"
+	.string "voice from the void.$"
+
+MossdeepCity_SpaceCenter_1F_Text_SecondSignal:
+	.string "There is a second signal. Far\n"
+	.string "stronger than the first.\p"
+	.string "It does not come from METEOR\n"
+	.string "FALLS. It comes from the sea --\l"
+	.string "from an island that appears on no\l"
+	.string "chart we hold.\p"
+	.string "Take this AURORA TICKET. The ferry\n"
+	.string "at LILYCOVE HARBOR honors it.\p"
+	.string "Whatever sent that signal… it is\n"
+	.string "waiting to be found.$"
+
+MossdeepCity_SpaceCenter_1F_Text_BringJirachi:
+	.string "The signal answers JIRACHI, and\n"
+	.string "JIRACHI answers the signal.\p"
+	.string "You've caught it, haven't you?\n"
+	.string "Bring it here. We must compare\l"
+	.string "readings.$"
+
+MossdeepCity_SpaceCenter_1F_Text_SecondSignalReminder:
+	.string "The second signal still pulses, out\n"
+	.string "at sea.\p"
+	.string "The ferry at LILYCOVE HARBOR\n"
+	.string "honors your AURORA TICKET.\p"
+	.string "An island that appears on no chart…\n"
+	.string "and a voice from the void.$"
+
 MossdeepCity_SpaceCenter_1F_Text_DidPokemonComeFromSpace:
 	.string "Some people claim that POKéMON came\n"
 	.string "from space. Could it be true?$"
