index a2bbe5391b839e78e25b8911e2d409a1bddc1194..897808bb826236b088ca2a1e6a57fc4db4c84397 100644
--- a/src/field_specials.c
+++ b/src/field_specials.c
@@ -4295,3 +4295,16 @@ u8 CheckJirachiCosmicAlignment(void)
     }
     return FALSE;
 }
+
+// TRUE when the given species (gSpecialVar_0x8004) is in the party.
+u8 CheckSpeciesInParty(void)
+{
+    u32 i;
+    u16 species = gSpecialVar_0x8004;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) == species)
+            return TRUE;
+    }
+    return FALSE;
+}
