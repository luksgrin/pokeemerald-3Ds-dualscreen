diff --git a/data/maps/VictoryRoad_CelebiShrine/scripts.inc b/data/maps/VictoryRoad_CelebiShrine/scripts.inc
new file mode 100644
index 0000000000000000000000000000000000000000..496e1a1009c8ae9ded6635b19eeeab6b5c849cf6
--- /dev/null
+++ b/data/maps/VictoryRoad_CelebiShrine/scripts.inc
@@ -0,0 +1,142 @@
+VictoryRoad_CelebiShrine_MapScripts::
+	map_script MAP_SCRIPT_ON_LOAD, VictoryRoad_CelebiShrine_OnLoad
+	.byte 0
+
+VictoryRoad_CelebiShrine_OnLoad:
+	call_if_set FLAG_CELEBI_SHRINE_RESTORED, VictoryRoad_CelebiShrine_EventScript_ApplyRestoredTiles
+	end
+
+VictoryRoad_CelebiShrine_EventScript_ApplyRestoredTiles::
+	setmetatile 6, 2, METATILE_Cave_ShoalCave_BlueStone_Large, FALSE
+	setmetatile 7, 2, METATILE_Cave_ShoalCave_BlueStone_Large, FALSE
+	setmetatile 4, 4, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 9, 4, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 5, 6, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 8, 6, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	return
+
+VictoryRoad_CelebiShrine_EventScript_CelebiAltar::
+	lockall
+	goto_if_set FLAG_CAUGHT_CELEBI, VictoryRoad_CelebiShrine_EventScript_ShrineAtPeace
+	goto_if_unset FLAG_CELEBI_SHRINE_RESTORED, VictoryRoad_CelebiShrine_EventScript_AltarDamaged
+	msgbox VictoryRoad_CelebiShrine_Text_GentleBreeze, MSGBOX_DEFAULT
+	msgbox VictoryRoad_CelebiShrine_Text_SomethingApproaches, MSGBOX_DEFAULT
+	waitse
+	playmoncry SPECIES_CELEBI, CRY_MODE_ENCOUNTER
+	delay 40
+	waitmoncry
+	seteventmon SPECIES_CELEBI, 40
+	setflag FLAG_SYS_CTRL_OBJ_DELETE
+	special BattleSetup_StartLegendaryBattle
+	waitstate
+	clearflag FLAG_SYS_CTRL_OBJ_DELETE
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_eq VAR_RESULT, B_OUTCOME_WON, VictoryRoad_CelebiShrine_EventScript_CelebiDefeated
+	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, VictoryRoad_CelebiShrine_EventScript_CelebiVanished
+	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, VictoryRoad_CelebiShrine_EventScript_CelebiVanished
+	goto_if_eq VAR_RESULT, B_OUTCOME_MON_TELEPORTED, VictoryRoad_CelebiShrine_EventScript_CelebiVanished
+	setflag FLAG_CAUGHT_CELEBI
+	msgbox VictoryRoad_CelebiShrine_Text_CelebiCaught, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_CelebiDefeated::
+	setflag FLAG_DEFEATED_CELEBI
+	msgbox VictoryRoad_CelebiShrine_Text_CelebiVanished, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_CelebiVanished::
+	msgbox VictoryRoad_CelebiShrine_Text_CelebiVanished, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_AltarDamaged::
+	msgbox VictoryRoad_CelebiShrine_Text_AltarDamaged, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_ShrineAtPeace::
+	msgbox VictoryRoad_CelebiShrine_Text_ShrineAtPeace, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_CelebiInscription::
+	lockall
+	goto_if_unset FLAG_CELEBI_SHRINE_RESTORED, VictoryRoad_CelebiShrine_EventScript_InscriptionOld
+	msgbox VictoryRoad_CelebiShrine_Text_InscriptionRestored, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_InscriptionOld::
+	msgbox VictoryRoad_CelebiShrine_Text_InscriptionOld, MSGBOX_DEFAULT
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_EventScript_CelebiShrineRestore::
+	lockall
+	msgbox VictoryRoad_CelebiShrine_Text_JirachiReacting, MSGBOX_DEFAULT
+	playse SE_M_HEAL_BELL
+	setmetatile 6, 2, METATILE_Cave_ShoalCave_BlueStone_Large, FALSE
+	setmetatile 7, 2, METATILE_Cave_ShoalCave_BlueStone_Large, FALSE
+	setmetatile 4, 4, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 9, 4, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 5, 6, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	setmetatile 8, 6, METATILE_Cave_ShoalCave_BlueStone_Small, FALSE
+	special DrawWholeMapView
+	msgbox VictoryRoad_CelebiShrine_Text_ShrineRestored, MSGBOX_DEFAULT
+	setflag FLAG_CELEBI_SHRINE_RESTORED
+	releaseall
+	end
+
+VictoryRoad_CelebiShrine_Text_AltarDamaged:
+	.string "An ancient shrine…\p"
+	.string "The altar is badly damaged.\n"
+	.string "The surrounding flowers have\l"
+	.string "withered.$"
+
+VictoryRoad_CelebiShrine_Text_GentleBreeze:
+	.string "A gentle breeze passes through the\n"
+	.string "shrine…$"
+
+VictoryRoad_CelebiShrine_Text_SomethingApproaches:
+	.string "Something is approaching…$"
+
+VictoryRoad_CelebiShrine_Text_CelebiCaught:
+	.string "The little POKéMON nodded once, as\n"
+	.string "if in thanks, and returned to the\l"
+	.string "shrine's care.$"
+
+VictoryRoad_CelebiShrine_Text_CelebiVanished:
+	.string "The guardian of the forest vanished\n"
+	.string "into the shrine…$"
+
+VictoryRoad_CelebiShrine_Text_ShrineAtPeace:
+	.string "The shrine is whole, and at peace.\n"
+	.string "Flowers bloom around the altar.$"
+
+VictoryRoad_CelebiShrine_Text_InscriptionOld:
+	.string "Carvings crawl across the stone,\n"
+	.string "scorched nearly smooth.\p"
+	.string "“…REST THE WOODS…\n"
+	.string "…RETURN THE SCENT OF FLOWERS…”\p"
+	.string "The rest is lost to the fire.$"
+
+VictoryRoad_CelebiShrine_Text_InscriptionRestored:
+	.string "The carvings seem to deepen as you\n"
+	.string "trace them…\p"
+	.string "“SWEETNESS WAKES THE WOODS.\n"
+	.string "A WISH KEPT NEAR REKINDLES WHAT\l"
+	.string "THE FIRE TOOK.”\p"
+	.string "The flowers have returned the\n"
+	.string "stone's voice.$"
+
+VictoryRoad_CelebiShrine_Text_JirachiReacting:
+	.string "JIRACHI is reacting to the shrine!\p"
+	.string "A mysterious energy fills the\n"
+	.string "air…$"
+
+VictoryRoad_CelebiShrine_Text_ShrineRestored:
+	.string "The burnt altar begins to glow…\p"
+	.string "Flowers bloom around the shrine!\p"
+	.string "The shrine has been restored!$"
