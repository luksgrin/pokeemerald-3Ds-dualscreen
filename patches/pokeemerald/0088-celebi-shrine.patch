@@ -9,19 +9,43 @@
 #include "mirage_tower.h"
 #include "palette.h"
 #include "party_menu.h"
+#include "pokemon.h"
 #include "script.h"
 #include "sound.h"
 #include "sprite.h"
 #include "task.h"
 #include "wild_encounter.h"
 #include "constants/field_effects.h"
+#include "constants/flags.h"
