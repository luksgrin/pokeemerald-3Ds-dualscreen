 static void FieldCallback_SweetScent(void);
 static void StartSweetScentFieldEffect(void);
 static void TrySweetScentEncounter(u8 taskId);
 static void FailSweetScentEncounter(u8 taskId);
+static bool8 ShouldTriggerCelebiShrineRestore(void);
+
+// The forgotten shrine past Victory Road: with JIRACHI in the party, using
+// SWEET SCENT there restores the shrine instead of failing to find POKéMON.
+static bool8 ShouldTriggerCelebiShrineRestore(void)
+{
+    u32 i;
+
+    if (gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_VICTORY_ROAD_CELEBI_SHRINE)
+        || gSaveBlock1Ptr->location.mapNum != MAP_NUM(MAP_VICTORY_ROAD_CELEBI_SHRINE))
+        return FALSE;
+    if (FlagGet(FLAG_CELEBI_SHRINE_RESTORED) == TRUE)
+        return FALSE;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, 0) == SPECIES_JIRACHI)
+            return TRUE;
+    }
+    return FALSE;
+}
 
 bool8 SetUpFieldMove_SweetScent(void)
 {
@@ -93,7 +117,10 @@ static void FailSweetScentEncounter(u8 taskId)
     {
         CpuFastCopy(gPaletteDecompressionBuffer, gPlttBufferUnfaded, PLTT_BUFFER_ALLOC_BYTES);
         SetWeatherPalStateIdle();
-        ScriptContext_SetupScript(EventScript_FailSweetScent);
+        if (ShouldTriggerCelebiShrineRestore() == TRUE)
+            ScriptContext_SetupScript(VictoryRoad_CelebiShrine_EventScript_CelebiShrineRestore);
+        else
+            ScriptContext_SetupScript(EventScript_FailSweetScent);
         DestroyTask(taskId);
     }
 }
