diff --git a/data/maps/MeteorFalls_B1F_2R/scripts.inc b/data/maps/MeteorFalls_B1F_2R/scripts.inc
index a1d8d5b..ce65ea9 100644
--- a/data/maps/MeteorFalls_B1F_2R/scripts.inc
+++ b/data/maps/MeteorFalls_B1F_2R/scripts.inc
@@ -1,3 +1,143 @@
 MeteorFalls_B1F_2R_MapScripts::
+	map_script MAP_SCRIPT_ON_LOAD, MeteorFalls_B1F_2R_OnLoad
 	.byte 0
 
+MeteorFalls_B1F_2R_OnLoad:
+	call_if_unset FLAG_JIRACHI_QUEST_STARTED, MeteorFalls_B1F_2R_EventScript_HideSteven
+	call_if_set FLAG_JIRACHI_DOOR_OPEN, MeteorFalls_B1F_2R_EventScript_OpenJirachiChamber
+	end
+
+MeteorFalls_B1F_2R_EventScript_HideSteven:
+	setflag FLAG_HIDE_METEOR_FALLS_B1F_2R_STEVEN
+	return
+
+MeteorFalls_B1F_2R_EventScript_OpenJirachiChamber:
+	setmetatile 4, 1, METATILE_MeteorFalls_CaveEntrance_Top, TRUE
+	setmetatile 3, 2, METATILE_MeteorFalls_CaveEntrance_Left, TRUE
+	setmetatile 4, 2, METATILE_MeteorFalls_CaveEntrance_Bottom, FALSE
+	setmetatile 5, 2, METATILE_MeteorFalls_CaveEntrance_Right, TRUE
+	return
+
+MeteorFalls_B1F_2R_EventScript_Steven::
+	lock
+	faceplayer
+	goto_if_set FLAG_DEFEATED_METEOR_FALLS_STEVEN, MeteorFalls_B1F_2R_EventScript_StevenDefeated
+	waitse
+	playse SE_PIN
+	applymovement LOCALID_METEOR_FALLS_B1F_2R_STEVEN, Common_Movement_ExclamationMark
+	waitmovement 0
+	applymovement LOCALID_METEOR_FALLS_B1F_2R_STEVEN, Common_Movement_Delay48
+	waitmovement 0
+	applymovement LOCALID_METEOR_FALLS_B1F_2R_STEVEN, Common_Movement_FacePlayer
+	waitmovement 0
+	msgbox MeteorFalls_B1F_2R_Text_StevenChallenge, MSGBOX_DEFAULT
+	trainerbattle_no_intro TRAINER_STEVEN, MeteorFalls_B1F_2R_Text_StevenDefeat
+	msgbox MeteorFalls_B1F_2R_Text_StevenPrediction, MSGBOX_DEFAULT
+	goto_if_set FLAG_JIRACHI_DOOR_OPEN, MeteorFalls_B1F_2R_EventScript_StevenFirstEnd
+	msgbox MeteorFalls_B1F_2R_Text_StevenCosmicHint, MSGBOX_DEFAULT
+MeteorFalls_B1F_2R_EventScript_StevenFirstEnd::
+	setflag FLAG_DEFEATED_METEOR_FALLS_STEVEN
+	release
+	end
+
+MeteorFalls_B1F_2R_EventScript_StevenDefeated::
+	applymovement LOCALID_METEOR_FALLS_B1F_2R_STEVEN, Common_Movement_FacePlayer
+	waitmovement 0
+	msgbox MeteorFalls_B1F_2R_Text_StevenPrediction, MSGBOX_DEFAULT
+	goto_if_set FLAG_JIRACHI_DOOR_OPEN, MeteorFalls_B1F_2R_EventScript_StevenDefeatedEnd
+	msgbox MeteorFalls_B1F_2R_Text_StevenCosmicHint, MSGBOX_DEFAULT
+MeteorFalls_B1F_2R_EventScript_StevenDefeatedEnd::
+	release
+	end
+
+MeteorFalls_B1F_2R_EventScript_Marks::
+	lockall
+	goto_if_set FLAG_JIRACHI_DOOR_OPEN, MeteorFalls_B1F_2R_EventScript_MarksOpened
+	goto_if_unset FLAG_SYS_GAME_CLEAR, MeteorFalls_B1F_2R_EventScript_MarksHint
+	specialvar VAR_RESULT, CheckJirachiCosmicAlignment
+	goto_if_eq VAR_RESULT, FALSE, MeteorFalls_B1F_2R_EventScript_MarksHint
+	msgbox MeteorFalls_B1F_2R_Text_Marks, MSGBOX_DEFAULT
+	msgbox MeteorFalls_B1F_2R_Text_MarksResolve, MSGBOX_DEFAULT
+	waitse
+	playse SE_BANG
+	call MeteorFalls_B1F_2R_EventScript_OpenJirachiChamber
+	setflag FLAG_JIRACHI_DOOR_OPEN
+	special DrawWholeMapView
+	msgbox MeteorFalls_B1F_2R_Text_DoorOpened, MSGBOX_DEFAULT
+	releaseall
+	end
+
+MeteorFalls_B1F_2R_EventScript_MarksHint::
+	msgbox MeteorFalls_B1F_2R_Text_Marks, MSGBOX_DEFAULT
+	releaseall
+	end
+
+MeteorFalls_B1F_2R_EventScript_MarksOpened::
+	msgbox MeteorFalls_B1F_2R_Text_MarksOpened, MSGBOX_DEFAULT
+	releaseall
+	end
+
+MeteorFalls_B1F_2R_Text_StevenChallenge:
+	.string "STEVEN: Oh, wow, {PLAYER}{KUN}.\n"
+	.string "I'm amazed you knew where to find me.\p"
+	.string "Do you, uh…maybe think of me as\n"
+	.string "just a rock maniac?\p"
+	.string "No, that can't be right.\p"
+	.string "We battled alongside each other at\n"
+	.string "the SOOTOPOLIS SPACE CENTER.\p"
+	.string "You should have a very good idea\n"
+	.string "about how good I am.\p"
+	.string "Okay, {PLAYER}{KUN}, if you're going to mount\n"
+	.string "a serious challenge, expect the worst!$"
+
+MeteorFalls_B1F_2R_Text_StevenDefeat:
+	.string "You…\n"
+	.string "I had no idea you'd become so strong…$"
+
+MeteorFalls_B1F_2R_Text_StevenPrediction:
+	.string "STEVEN: Come to think of it, ever since\n"
+	.string "our paths first crossed in GRANITE\l"
+	.string "CAVE in DEWFORD, I had this feeling.\p"
+	.string "I thought that you would eventually\n"
+	.string "become the CHAMPION.\p"
+	.string "My predictions usually come true.\p"
+	.string "And where will you go from here?\p"
+	.string "… … … … … …\n"
+	.string "… … … … … …\p"
+	.string "Fufufu, even I couldn't tell you that.$"
+
+MeteorFalls_B1F_2R_Text_StevenCosmicHint:
+	.string "STEVEN: Oh, yes. If you're here, then\n"
+	.string "perhaps you've heard it too.\p"
+	.string "The SPACE CENTER registers a faint\n"
+	.string "signal from deep within these falls.\p"
+	.string "I've analyzed it. It is no mere\n"
+	.string "geology. It ebbs and flows like\l"
+	.string "COSMIC POWER, the move that draws\n"
+	.string "strength from space itself.\p"
+	.string "And those marks on the wall there…\n"
+	.string "The sun, and the moon.\p"
+	.string "What a stone might wish for,\n"
+	.string "even I couldn't tell you.$"
+
+MeteorFalls_B1F_2R_Text_Marks:
+	.string "It's a bulge in the rock wall.\p"
+	.string "Ancient marks are cut deep into\n"
+	.string "the stone: a radiant circle,\l"
+	.string "followed by a crescent moon.\p"
+	.string "“The sun goes first.\n"
+	.string "The moon walks last.\l"
+	.string "Let either wield the cosmos,\n"
+	.string "and the way will open.”$"
+
+MeteorFalls_B1F_2R_Text_MarksResolve:
+	.string "The marks answer the presence of\n"
+	.string "your POKéMON with a low rumble…$"
+
+MeteorFalls_B1F_2R_Text_DoorOpened:
+	.string "The stone split open, revealing\n"
+	.string "a hidden chamber beyond!$"
+
+MeteorFalls_B1F_2R_Text_MarksOpened:
+	.string "The marks have done their part.\n"
+	.string "The way lies open.$"
