+++ b/data/maps/MeteorFalls_B1F_2R/scripts.inc
@@ -1,3 +1,143 @@
 MeteorFalls_B1F_2R_MapScripts::
+	map_script MAP_SCRIPT_ON_LOAD, MeteorFalls_B1F_2R_OnLoad
 	.byte 0
 
+MeteorFalls_B1F_2R_OnLoad:
+	call_if_unset FLAG_JIRACHI_QUEST_STARTED, MeteorFalls_B1F_2R_EventScript_HideSteven
+	call_if_set FLAG_JIRACHI_DOOR_OPEN, MeteorFalls_B1F_2R_EventScript_OpenJirachiChamber
+	end
+
+MeteorFalls_B1F_2R_EventScript_HideSteven:
+	setflag FLAG_HIDE_METEOR_FALLS_B1F_2R_STEVEN
+	return
+
+MeteorFalls_B1F_2R_EventScript_OpenJirachiChamber:
+	setmetatile 2, 1, METATILE_MeteorFalls_CaveEntrance_Top, TRUE
+	setmetatile 1, 2, METATILE_MeteorFalls_CaveEntrance_Left, TRUE
+	setmetatile 2, 2, METATILE_MeteorFalls_CaveEntrance_Bottom, FALSE
+	setmetatile 3, 2, METATILE_MeteorFalls_CaveEntrance_Right, TRUE
+	return
+
+MeteorFalls_B1F_2R_EventScript_Steven::
+	lock
+	faceplayer
