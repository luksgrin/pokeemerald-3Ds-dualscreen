+// TRUE when the party is arranged for the Jirachi chamber: SOLROCK leads,
+// LUNATONE is sixth, and either knows COSMIC POWER.
+u8 CheckJirachiCosmicAlignment(void)
+{
+    u32 i;
+    if (GetMonData(&gPlayerParty[0], MON_DATA_SPECIES) != SPECIES_SOLROCK)
+        return FALSE;
+    if (GetMonData(&gPlayerParty[PARTY_SIZE - 1], MON_DATA_SPECIES) != SPECIES_LUNATONE)
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (GetMonData(&gPlayerParty[0], MON_DATA_MOVE1 + i) == MOVE_COSMIC_POWER)
+            return TRUE;
+        if (GetMonData(&gPlayerParty[PARTY_SIZE - 1], MON_DATA_MOVE1 + i) == MOVE_COSMIC_POWER)
+            return TRUE;
+    }
+    return FALSE;
+}
