new file mode 100644
index 0000000..322833a
--- /dev/null
+++ b/data/maps/MeteorFalls_JirachiChamber/scripts.inc
@@ -0,0 +1,62 @@
+MeteorFalls_JirachiChamber_MapScripts::
+	.byte 0
+
+MeteorFalls_JirachiChamber_EventScript_WhiteRock::
+	goto_if_set FLAG_CAUGHT_JIRACHI, MeteorFalls_JirachiChamber_EventScript_RockAfterCaught
+	goto_if_set FLAG_DEFEATED_JIRACHI, MeteorFalls_JirachiChamber_EventScript_RockAfterDefeated
+	lockall
+	msgbox MeteorFalls_JirachiChamber_Text_WhiteRock, MSGBOX_DEFAULT
+	waitse
+	playmoncry SPECIES_JIRACHI, CRY_MODE_ENCOUNTER
+	delay 40
+	waitmoncry
+	seteventmon SPECIES_JIRACHI, 40
+	setflag FLAG_SYS_CTRL_OBJ_DELETE
+	special BattleSetup_StartLegendaryBattle
+	waitstate
+	clearflag FLAG_SYS_CTRL_OBJ_DELETE
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_eq VAR_RESULT, B_OUTCOME_WON, MeteorFalls_JirachiChamber_EventScript_JirachiDefeated
+	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, MeteorFalls_JirachiChamber_EventScript_JirachiFled
+	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, MeteorFalls_JirachiChamber_EventScript_JirachiFled
+	goto_if_eq VAR_RESULT, B_OUTCOME_MON_TELEPORTED, MeteorFalls_JirachiChamber_EventScript_JirachiFled
+	setflag FLAG_CAUGHT_JIRACHI
+	releaseall
+	end
+
+MeteorFalls_JirachiChamber_EventScript_JirachiFled::
+	msgbox MeteorFalls_JirachiChamber_Text_RockStillWarm, MSGBOX_DEFAULT
+	releaseall
+	end
+
+MeteorFalls_JirachiChamber_EventScript_JirachiDefeated::
+	setflag FLAG_DEFEATED_JIRACHI
+	msgbox MeteorFalls_JirachiChamber_Text_RockWentCold, MSGBOX_DEFAULT
+	releaseall
+	end
+
+MeteorFalls_JirachiChamber_EventScript_RockAfterCaught::
+	msgbox MeteorFalls_JirachiChamber_Text_RockAfterCaught, MSGBOX_SIGN
+	end
+
+MeteorFalls_JirachiChamber_EventScript_RockAfterDefeated::
+	msgbox MeteorFalls_JirachiChamber_Text_RockWentCold, MSGBOX_SIGN
+	end
+
+MeteorFalls_JirachiChamber_Text_WhiteRock:
+	.string "It's a white rock…\p"
+	.string "A faint warmth pulses from\n"
+	.string "within, like a heartbeat…$"
+
+MeteorFalls_JirachiChamber_Text_RockStillWarm:
+	.string "The white rock is still warm…\n"
+	.string "It may yet answer again.$"
+
+MeteorFalls_JirachiChamber_Text_RockWentCold:
+	.string "The white rock has gone cold.\n"
+	.string "Whatever lived within is gone now…$"
+
+MeteorFalls_JirachiChamber_Text_RockAfterCaught:
+	.string "It's a white rock.\p"
+	.string "Its warmth has faded, but a\n"
+	.string "peaceful feeling remains.$"
