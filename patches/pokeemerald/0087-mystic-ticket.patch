@@ -585,3 +585,92 @@ LilycoveCity_Harbor_Text_SailorFerryAvailable:
 	.string "The folks at the SHIPYARD in SLATEPORT\n"
 	.string "must've worked extra hard.\p"
 	.string "Well, it's my turn to get busy now!$"
+
+LilycoveCity_Harbor_EventScript_OldSalt::
+	lock
+	faceplayer
+	goto_if_set FLAG_SYS_GAME_CLEAR, LilycoveCity_Harbor_EventScript_OldSaltPostgame
+	msgbox LilycoveCity_Harbor_Text_OldSaltVanilla, MSGBOX_DEFAULT
+	release
+	end
+
+LilycoveCity_Harbor_EventScript_OldSaltPostgame::
+	checkitem ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_RESULT, TRUE, LilycoveCity_Harbor_EventScript_OldSaltRecognizeMap
+	goto_if_unset FLAG_MT_PYRE_INSCRIPTION_READ, LilycoveCity_Harbor_EventScript_OldSaltNotYet
+	goto_if_set FLAG_MYSTIC_TICKET_GIVEN, LilycoveCity_Harbor_EventScript_OldSaltIdle
+	msgbox LilycoveCity_Harbor_Text_OldSaltLegend, MSGBOX_DEFAULT
+	msgbox LilycoveCity_Harbor_Text_OldSaltRecord, MSGBOX_DEFAULT
+	giveitem ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_MYSTIC_TICKET_GIVEN
+	release
+	end
+
+LilycoveCity_Harbor_EventScript_OldSaltRecognizeMap::
+	goto_if_set FLAG_OLD_SEA_MAP_RECOGNIZED, LilycoveCity_Harbor_EventScript_OldSaltIdle
+	msgbox LilycoveCity_Harbor_Text_OldSaltRecognizesMap, MSGBOX_DEFAULT
+	setflag FLAG_ENABLE_SHIP_FARAWAY_ISLAND
+	setflag FLAG_OLD_SEA_MAP_RECOGNIZED
+	release
+	end
+
+LilycoveCity_Harbor_EventScript_OldSaltNotYet::
+	msgbox LilycoveCity_Harbor_Text_OldSaltNotYet, MSGBOX_DEFAULT
+	release
+	end
+
+LilycoveCity_Harbor_EventScript_OldSaltIdle::
+	msgbox LilycoveCity_Harbor_Text_OldSaltIdle, MSGBOX_DEFAULT
+	release
+	end
+
+LilycoveCity_Harbor_Text_OldSaltVanilla:
+	.string "Yo. Tide's strong today.\p"
+	.string "The S.S. TIDAL doesn't mind a little\n"
+	.string "chop, though.$"
+
+LilycoveCity_Harbor_Text_OldSaltLegend:
+	.string "An old salt like me doesn't put much\n"
+	.string "stock in legends, but the records…\p"
+	.string "The maritime records tell of a sacred\n"
+	.string "isle, far past the westerly currents.\l"
+	.string "Guarded since before charts were drawn.\p"
+	.string "And now an old woman on MT. PYRE\n"
+	.string "is telling people the guardians have\l"
+	.string "chosen someone.\p"
+	.string "You read the stone on that summit,\n"
+	.string "didn't you? I knew it the moment I\l"
+	.string "saw you.\p"
+	.string "Here. The MYSTIC TICKET. My captain's\n"
+	.string "days are done, but the ferry will\l"
+	.string "honor it.$"
+
+LilycoveCity_Harbor_Text_OldSaltRecord:
+	.string "Show it at the counter there. They'll\n"
+	.string "take you straight to NAVEL ROCK --\l"
+	.string "the isle where the sky and the sea\n"
+	.string "keep their watchers.$"
+
+LilycoveCity_Harbor_Text_OldSaltRecognizesMap:
+	.string "Well, blow me down. That's an OLD\n"
+	.string "SEA MAP -- a route the ferry lines\l"
+	.string "stopped sailing generations ago.\p"
+	.string "The attendants at the counter will\n"
+	.string "honor it. A friend of mine, old\n"
+	.string "BRINEY… he'll want to see this, too.$"
+
+LilycoveCity_Harbor_Text_OldSaltNotYet:
+	.string "These waters keep their secrets.\n"
+	.string "The old records speak of a sacred\l"
+	.string "isle, but they only open up to those\l"
+	.string "who've stood where the guardians are\l"
+	.string "honored.\p"
+	.string "…MT. PYRE, maybe. Its summit sees\n"
+	.string "all of HOENN.$"
+
+LilycoveCity_Harbor_Text_OldSaltIdle:
+	.string "The sea's patient. It'll show you\n"
+	.string "what it means to, when it's time.$"
+
