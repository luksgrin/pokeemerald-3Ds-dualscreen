 	release
 	end
 
+PlayersHouse_1F_EventScript_MomPostgameCheck::
+	goto_if_set FLAG_EON_TICKET_GIVEN, PlayersHouse_1F_EventScript_MomEonReminder
+	specialvar VAR_RESULT, CheckRoamingEonInParty
+	goto_if_eq VAR_RESULT, FALSE, PlayersHouse_1F_EventScript_TryRegisterMom
+	msgbox PlayersHouse_1F_Text_MomLetterArrived, MSGBOX_DEFAULT
+	msgbox PlayersHouse_1F_Text_MomLetterContents, MSGBOX_DEFAULT
+	giveitem ITEM_EON_TICKET
+	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
+	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
+	setflag FLAG_EON_TICKET_GIVEN
+	release
+	end
+
+PlayersHouse_1F_EventScript_MomEonReminder::
+	msgbox PlayersHouse_1F_Text_MomEonReminder, MSGBOX_DEFAULT
+	goto PlayersHouse_1F_EventScript_TryRegisterMom
+	end
+
 PlayersHouse_1F_EventScript_DontPushYourselfTooHard::
 	msgbox PlayersHouse_1F_Text_DontPushYourselfTooHard, MSGBOX_DEFAULT
 	release
@@ -673,3 +692,27 @@ PlayersHouse_1F_Movement_PlayerApproachTVForLatiFemale:
 EventScript_RunningShoesManual::
 	msgbox PlayersHouse_1F_Text_RunningShoesManual, MSGBOX_SIGN
 	end
+
+PlayersHouse_1F_Text_MomLetterArrived:
+	.string "Oh, {PLAYER}{KUN}! A letter arrived for\n"
+	.string "you while you were out.\p"
+	.string "All the way from the ferry company,\n"
+	.string "if you can believe it.$"
+
+PlayersHouse_1F_Text_MomLetterContents:
+	.string "Let's see… “We have taken note of\n"
+	.string "your bond with the EON POKéMON.\l"
+	.string "Riders of the wind and sea are rare.”\p"
+	.string "“A sighting of one of its kin has been\n"
+	.string "reported on a remote island south\l"
+	.string "of HOENN.”\p"
+	.string "Oh, and a ticket fell out when I\n"
+	.string "opened it. Here you are.\p"
+	.string "The EON TICKET. Do be careful out\n"
+	.string "there, dear.$"
+
+PlayersHouse_1F_Text_MomEonReminder:
+	.string "The EON TICKET still rides in your\n"
+	.string "pack, doesn't it?\p"
+	.string "The ferry at LILYCOVE HARBOR will\n"
+	.string "honor it, whenever you wish.$"
