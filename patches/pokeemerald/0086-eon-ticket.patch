+
+// TRUE when the roaming EON POKéMON (the counterpart to the one the player
+// chose on television) is in the party: the Eon Ticket scene.
+u8 CheckRoamingEonInParty(void)
+{
+    gSpecialVar_0x8004 = VarGet(VAR_ROAMER_POKEMON) ? SPECIES_LATIOS : SPECIES_LATIAS;
+    return CheckSpeciesInParty();
+}
