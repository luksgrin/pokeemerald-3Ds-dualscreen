diff --git a/data/maps/AbandonedShip_ExpeditionHold/scripts.inc b/data/maps/AbandonedShip_ExpeditionHold/scripts.inc
new file mode 100644
index 0000000000000000000000000000000000000000..1dd38261c97fba1d9142e20e338ef00dd0de6b34
--- /dev/null
+++ b/data/maps/AbandonedShip_ExpeditionHold/scripts.inc
@@ -0,0 +1,25 @@
+AbandonedShip_ExpeditionHold_MapScripts::
+	.byte 0
+
+AbandonedShip_ExpeditionHold_EventScript_Diary::
+	lockall
+	msgbox AbandonedShip_ExpeditionHold_Text_Diary, MSGBOX_DEFAULT
+	releaseall
+	end
+
+AbandonedShip_ExpeditionHold_Text_Diary:
+	.string "…The final entry in the expedition's\n"
+	.string "logbook. The hand grows unsteady.\p"
+	.string "“At long last we sighted it. An\n"
+	.string "island that appears on no ordinary\l"
+	.string "map. Our charts refuse to hold its\l"
+	.string "shape.”\p"
+	.string "“Each night, strange sounds drift\n"
+	.string "from the forest. Songs unlike any\l"
+	.string "POKéMON we know. We never once saw\l"
+	.string "what sang them.”\p"
+	.string "“The OLD SEA MAP alone shows the\l"
+	.string "way. If the finder of this diary\l"
+	.string "follows it… go gently.\p"
+	.string "The island was singing long before\l"
+	.string "we came.”$"
